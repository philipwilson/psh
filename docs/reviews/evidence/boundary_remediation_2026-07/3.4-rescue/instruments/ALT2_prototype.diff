+    def expand_prefix(self, raw_assignments: List[RawAssignment]) -> 'StagedPrefix':
+        """PROTOTYPE phase 1: expand values left-to-right ONCE and stage them.
+
+        Each value's expansion sees the bindings to its left (staged in a
+        command temp-env layer) and any real shell-state side effect an
+        expansion performs (arithmetic assignment, ``:=`` store) lands live —
+        so RESOLUTION, which runs after this, reads authoritative state.
+        """
+        scope_manager = self.state.scope_manager
+        pairs: List[Tuple[str, object]] = []
+        saved_vars: Dict[str, dict] = {}
+        assignment_error = False
+        pushed_temp_env = False
+        xtrace = self.state.options.get('xtrace')
+        for var, value, value_word in raw_assignments:
+            value = self._expand_value(value, value_word)
+            if xtrace:
+                ps4 = self.expansion_manager.expand_ps4()
+                self.state.stderr.write(f"{ps4}{var}={xtrace_quote(value)}\n")
+            var, resolved = resolve_append_assignment(scope_manager, var, value)
+            write_name = scope_manager.resolve_nameref_name(var)
+            if '[' not in write_name:
+                var = write_name
+            # ALT-2: dynamic specials are NOT seeded during staging — a
+            # temp-env SCOPE binding MASKS them, which is what bash's temp env
+            # does (carry #7). Only arrays / nameref-to-element still need the
+            # seed route, and they cannot live in a scope binding.
+            use_seed_path = (
+                isinstance(resolved, (IndexedArray, AssociativeArray))
+                or '[' in write_name)
+            if use_seed_path:
+                if var not in saved_vars:
+                    existing = scope_manager.get_variable_object(var)
+                    existing_val = existing.value if existing is not None else None
+                    if isinstance(existing_val, (IndexedArray, AssociativeArray)):
+                        state_snapshot: object = copy.deepcopy(existing_val)
+                    else:
+                        state_snapshot = scope_manager.get_variable(var)
+                    saved_vars[var] = {
+                        'state': state_snapshot,
+                        'was_exported': bool(existing and existing.is_exported),
+                    }
+                try:
+                    scope_manager.set_variable(
+                        var, resolved, attributes=VarAttributes.EXPORT, local=False)
+                except ReadonlyVariableError as e:
+                    print(f"{self.state.error_location_prefix()}{e.name}: readonly variable",
+                          file=self.state.stderr)
+                    assignment_error = True
+                    continue
+                pairs.append((var, resolved))
+                continue
+            if not pushed_temp_env:
+                scope_manager.push_temp_env_scope()
+                pushed_temp_env = True
+            try:
+                scope_manager.set_temp_env_var(var, resolved)
+            except ReadonlyVariableError as e:
+                print(f"{self.state.error_location_prefix()}{e.name}: readonly variable",
+                      file=self.state.stderr)
+                assignment_error = True
+                continue
+            pairs.append((var, resolved))
+        return StagedPrefix(pairs, saved_vars, assignment_error, pushed_temp_env)
+
+    def commit_prefix(self, staged: 'StagedPrefix',
+                      temp_scope: bool) -> PrefixOutcome:
+        """PROTOTYPE ALT-2 phase 2: route the ALREADY-EXPANDED pairs.
+
+        FUNCTION target: the staging SCOPE *is* the destination — zero
