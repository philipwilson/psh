##### P21b trap entry-status discriminating shapes
--- bash [g(){ false; exit; }; trap g EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "false; { exit; }" EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "false; eval exit" EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "false; for i in 1; do exit; done" EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "false; . ./t.sh" EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "false; exit" USR1; kill -USR1 $$; echo x]:
rc=0
--- psh:
rc=1
--- bash [trap "false; exit" ERR; (exit 5)]:
rc=5
--- psh:
rc=1
--- bash [trap "false; (exit 7); exit" EXIT; (exit 5)]:
rc=5
--- psh:
rc=5
--- bash [trap "echo entry=\$?; false; exit" EXIT; (exit 5)]:
entry=5
rc=5
--- psh:
entry=5
rc=5
