##### 2.1 signal/ERR trap boundary shapes
--- bash [g(){ false; exit; }; trap g ERR; (exit 5)]:
rc=1
--- psh:
rc=1
--- bash [trap "false; . ./t.sh" ERR; (exit 5)]:
rc=1
--- psh:
rc=1
--- bash [trap "false; { exit; }" ERR; (exit 5)]:
rc=5
--- psh:
rc=1
--- bash [trap "false; eval exit" ERR; (exit 5)]:
rc=5
--- psh:
rc=1
--- bash [trap "false; if true; then exit; fi" ERR; (exit 5)]:
rc=5
--- psh:
rc=0
--- bash [trap "false; (exit); echo sub-rc=\$?" ERR; (exit 5); echo after]:
sub-rc=1
after
rc=0
--- psh:
sub-rc=1
after
rc=0
--- bash [g(){ false; exit; }; trap g USR1; kill -USR1 $$; echo x]:
rc=1
--- psh:
rc=1
--- bash [trap "false; . ./t.sh" USR1; kill -USR1 $$; echo x]:
rc=1
--- psh:
rc=1
--- bash [trap "false; { exit; }" USR1; kill -USR1 $$; echo x]:
rc=0
--- psh:
rc=1
--- bash [trap "false; exit" DEBUG; true]:
rc=1
--- psh:
rc=1
--- bash [trap "false; exit" RETURN; f(){ :; }; f; echo x]:
x
rc=0
--- psh:
x
rc=0
